{
  "extends": ["@tsconfig/bases/node24", "@tsconfig/bases/strictest"],
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/vitest.config.ts",
    "scripts/**/*.ts",
    "*.config.ts"
  ],
  "exclude": ["packages/svelte", "**/node_modules", "**/dist"]
}
