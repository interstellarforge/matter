{
  "name": "@interstellarforge/matter-react",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Matter components for React 19 / Next.js. Styling comes from @interstellarforge/matter-css.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interstellarforge/matter.git",
    "directory": "packages/react"
  },
  "type": "module",
