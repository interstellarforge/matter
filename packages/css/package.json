{
  "name": "@interstellarforge/matter-css",
  "version": "0.2.2",
  "license": "MIT",
  "description": "Matter CSS distribution: token stylesheet and the no-flash theme init script. Framework-agnostic.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interstellarforge/matter.git",
    "directory": "packages/css"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./matter.css": "./dist/matter.css",
    "./theme-init.js": "./dist/theme-init.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "node src/build.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@interstellarforge/matter-tokens": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
